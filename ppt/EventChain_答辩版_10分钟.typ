#import "template.typ": *

// EventChain 课程答辩稿
// 版式参考：hpc101/trsm/slides/2trsm.typ
// 结构：1 页封面 + 9 页正文，讲解约 10 分钟

#show: presentation.with(
  title: [EventChain 面向校园体育的多组织可信参与系统],
  short-title: [EventChain],
  author: "EventChain 项目组",
  date: [2026-09],
  version: "V2",
  total-slides: 9,
  footer: [区块链技术与实践 · 课程答辩],
)

// ------------------------------------------------------------------------------
// 封面，0:00 至 0:30
// 讲者备注：介绍课程项目和场景。后续围绕共享状态、隐私边界、幂等执行展开。
// ------------------------------------------------------------------------------
#title-slide(
  title: [EventChain],
  subtitle: [面向校园体育的多组织可信参与系统],
  author: [EventChain 项目组],
  date: [2026年9月],
)

// ------------------------------------------------------------------------------
// 第 1 页，0:30 至 1:20
// 讲者备注：单一可信管理员场景用数据库更合适。本项目假设平台、学生和组织方
// 都需要核对资格、抽签、奖励和核销，同时不允许任一方事后单独改账。
// ------------------------------------------------------------------------------
#slide(
  title: [问题定义与使用边界],
  subtitle: [什么时候值得使用共享账本],
  section: [01 问题与边界],
)[
  #two-col-split(
    [
      #subhead([三类参与方])
      - *学生*：核对余额、仓位、抽签结果和票据
      - *组织方*：创建活动和市场，提交结果并履约
      - *平台*：管理身份，处理核验、结算与争议
    ],
    [
      #subhead([需要共同确认的状态])
      - *资格*：谁可以参加，使用哪个身份
      - *输入*：何时承诺，承诺内容是否被替换
      - *结果*：抽签和结算何时确定
      - *回执*：重复请求是否产生第二次业务效果
    ]
  )

  #v(12pt)

  #callout(type: "info", title: [项目假设])[
    平台、学生和组织方需要共享可审计状态。如果业务始终只有一个可信管理员，普通数据库更简单。
  ]
]

// ------------------------------------------------------------------------------
// 第 2 页，1:20 至 2:30
// 讲者备注：浏览器负责交互，Express 处理登录和网关连接，Fabric 保存业务状态。
// V2 网络只部署 finance 与 activity 两个链码。个人数据进入授权组织的私有集合。
// ------------------------------------------------------------------------------
#slide(
  title: [V2 系统架构],
  subtitle: [两个链码承担核心业务状态],
  section: [02 系统架构],
)[
  #steps-row((
    ([Vue 3 前端], [Pinia 管理状态，Element Plus 提供交互组件]),
    ([Express API], [SQLite 登录，Fabric Gateway 提交和查询交易]),
    ([Fabric 网络], [三个组织 Peer，一个 Raft Orderer，CouchDB 状态库]),
    ([V2 链码], [finance 处理资产，activity 处理活动与票务]),
  ))

  #v(12pt)

  #two-col-split(
    [
      #subhead([组织与共识])
      - *PlatformMSP*：平台、验证员、运营员和仲裁员
      - *OrganizerMSP*：赛事与活动组织方
      - *StudentMSP*：学生身份和本人私有状态
      - *eventchain channel*：共享公共业务状态
    ],
    [
      #subhead([链码职责], tag: badge-tech("V2"))
      - *finance*：A/B 钱包、预测、服务兑换与结算
      - *activity*：活动、承诺揭示抽签、票据与签到
      - 旧 `token`、`event`、`prediction`、`ticket` 链码只保留源码对照
    ]
  )

  #v(9pt)
  #callout(type: "tech", title: [私有数据集合])[
    PlatformMSP 与 StudentMSP 保存个人仓位、申请和票据。OrganizerMSP 不读取这些精确值。
  ]
]

// ------------------------------------------------------------------------------
// 第 3 页，2:30 至 3:30
// 讲者备注：A 是基础积分。B_paid 由 A 一比一兑换，可扣费兑回。
// B_bonus 来自签到或补偿，不能提现。预测默认只使用 B_bonus。
// ------------------------------------------------------------------------------
#slide(
  title: [封闭积分的账务边界],
  subtitle: [A、B_paid 与 B_bonus 分开记账],
  section: [03 积分系统],
)[
  #two-col-split(
    [
      #subhead([三类资产])
      #formula-card(title: [付费积分])[
        $ 1 A = 1 B_"paid" $
      ]
      #v(6pt)
      - *A*：系统内基础积分
      - *B_paid*：有 A 储备，兑回手续费为 0.5%
      - *B_bonus*：签到或补偿发放，不可兑回
      - B_paid 365 天到期自动退回 A，B_bonus 90 天到期销毁

      #v(8pt)
      #callout(type: "warning", title: [风险隔离])[
        预测市场默认只接受 B_bonus，避免奖励积分经过预测收益变成可兑回资产。
      ]
    ],
    [
      #subhead([真实浏览器读回], tag: badge-success("已验证"))
      #block(
        width: 100%,
        fill: white,
        stroke: 1pt + tech-border,
        radius: 6pt,
        inset: 5pt,
      )[
        #image("assets/defense/wallet-demo.png", width: 100%, height: 178pt, fit: "contain")
      ]
      #v(5pt)
      #text(size: 0.78em, fill: tech-text-sub)[A 减少 1，羽毛球 B_paid 增加 1。链码用整数微单位记账，禁止浮点运算。]
    ]
  )
]

// ------------------------------------------------------------------------------
// 第 4 页，3:30 至 4:40
// 讲者备注：市场公开信息经过延迟和取整。学生的精确结果、投入数量和账户仓位
// 保存在私有集合。同一幂等键再次提交时，后端返回原回执，不重复扣款。
// ------------------------------------------------------------------------------
#slide(
  title: [公开快照与私有仓位],
  subtitle: [市场可解释，个人选择不公开],
  section: [04 预测市场],
)[
  #two-col-split(
    [
      #subhead([公共世界状态], tag: badge-tech("公开"))
      - 结果标签和市场状态
      - 五分钟取整后的概率快照
      - 取整后的总池与市场上限
      #v(12pt)
      #callout(type: "info", title: [公开页面的作用])[
        页面能解释市场变化，但不能据此反推出某个学生的精确选择和投入数量。
      ]
    ],
    [
      #subhead([本人私有状态], tag: badge-purple("授权可见"))
      - 精确结果与投入数量
      - 匿名账户对应的 Position 对象
      - 幂等键对应的交易回执
      #v(12pt)
      #callout(type: "tech", title: [读写规则])[
        前端只能读取当前 Fabric 身份对应的数据。重复提交同一请求键不会再次扣减余额。
      ]
    ]
  )
]

// ------------------------------------------------------------------------------
// 第 5 页，4:40 至 6:00
// 讲者备注：验证员先提交种子哈希，学生在截止前申请。组织者截止后揭示原文。
// 链码核对承诺并计算可复核分数，取前 capacity 名。
// ------------------------------------------------------------------------------
#slide(
  title: [承诺揭示抽签],
  subtitle: [随机输入在申请名单确定前锁定],
  section: [05 抽签机制],
)[
  #steps-row((
    ([验证员], [提交种子承诺 $H(s)$]),
    ([学生], [报名截止前提交申请]),
    ([组织者], [截止后揭示种子 $s$]),
    ([链码], [核对承诺并按哈希排序]),
    ([学生], [私有读回 WON 或 LOST]),
  ))

  #v(12pt)

  #formula-card(title: [每个申请人的可复核分数])[
    $ "score"_i = "SHA256"(s | "activityId" | "accountId"_i) $
  ]

  #v(10pt)

  #two-col-split(
    [
      #subhead([排序规则])
      链码按哈希分数从小到大排序，取前 `capacity` 名。报名先后顺序不参与计算。
    ],
    [
      #subhead([链码拒绝的操作], tag: badge-danger("校验"))
      - 没有提前提交承诺
      - 报名尚未截止
      - 揭示原文与 $H(s)$ 不匹配
    ]
  )
]

// ------------------------------------------------------------------------------
// 第 6 页，6:00 至 7:30
// 讲者备注：票据秘密由浏览器生成，链上只保存哈希。动态二维码每 30 秒变化。
// 签到与奖励跨两个链码，后端使用两步幂等流程。奖励失败时保留签到结果并等待补发。
// ------------------------------------------------------------------------------
#slide(
  title: [动态票据与幂等签到],
  subtitle: [一张票只能核销一次],
  section: [06 票务链路],
)[
  #steps-row((
    ([学生领票], [浏览器生成随机票据秘密]),
    ([动态证明], [二维码携带时间片，不含原始秘密]),
    ([核销票据], [`activity.CheckIn` 确认一次性状态]),
    ([发放奖励], [`finance.GrantCheckInBonus` 增加 B_bonus]),
  ))

  #v(10pt)

  #two-col-split(
    [
      #subhead([核验条件])
      - 票据秘密与链上哈希一致
      - 时间片处于允许窗口
      - 票据状态有效，活动已经开始
      - 第二次核销返回 409

      #v(8pt)
      #callout(type: "warning", title: [跨链码边界])[
        签到和发奖不是原子事务。奖励提交失败时，系统保留签到并标记待补发，不再次核销票据。
      ]
    ],
    [
      #subhead([浏览器流程], tag: badge-success("真实演示"))
      #grid(
        columns: (1fr, 1fr),
        gutter: 6pt,
        block(fill: white, stroke: 1pt + tech-border, radius: 5pt, inset: 3pt)[
          #image("assets/defense/ticket-demo.png", width: 100%, height: 118pt, fit: "contain")
        ],
        block(fill: white, stroke: 1pt + tech-border, radius: 5pt, inset: 3pt)[
          #image("assets/defense/checkin-demo.png", width: 100%, height: 118pt, fit: "contain")
        ],
      )
      #v(5pt)
      #text(size: 0.75em, fill: tech-text-sub)[现场演示可上传二维码截图，避免单机摄像头切换影响流程。]
    ]
  )
]

// ------------------------------------------------------------------------------
// 第 7 页，7:30 至 8:20
// 讲者备注：前端只裁剪入口，Express 再校验登录角色，链码读取证书属性做最终授权。
// 绕过页面直接调用接口，仍然不能跳过链码权限。
// ------------------------------------------------------------------------------
#slide(
  title: [角色分离与最终授权],
  subtitle: [权限同时落实到接口与链码],
  section: [07 权限设计],
)[
  #tech-table(
    columns: (0.8fr, 2.8fr, 1.1fr, 1.35fr),
    headers: ([角色], [主要动作], [后端角色], [Fabric 身份]),
    rows: (
      ([学生], [兑换、建仓、报名与领票], [`student`], [StudentMSP]),
      ([组织者], [创建市场和活动，揭示抽签，提交结果], [`organizer`], [OrganizerMSP]),
      ([验证员], [承诺种子，二次确认市场结果], [`verifier`], [PlatformMSP]),
      ([运营员], [临时结算、Claim 批处理和签到核验], [`operator`], [PlatformMSP]),
      ([仲裁员], [对争议结果独立投票], [`arbitrator`], [PlatformMSP]),
    )
  )

  #v(12pt)

  #callout(type: "info", title: [三层校验])[
    Vue 根据角色提示可用入口，Express 中间件校验登录角色，链码读取 Fabric 证书属性作最终判定。
  ]
]

// ------------------------------------------------------------------------------
// 第 8 页，8:20 至 9:05
// 讲者备注：接口测试、浏览器流程测试、链码单元测试和生产构建覆盖关键状态。
// 浏览器测试使用 API 替身，它验证前端状态衔接，但不能替代真实 Fabric 写入。
// ------------------------------------------------------------------------------
#slide(
  title: [验证范围与证据],
  subtitle: [覆盖关键状态变化和重复请求],
  section: [08 测试验证],
)[
  #grid(
    columns: (1fr, 1fr, 1fr, 1fr),
    gutter: 8pt,
    stat-card(value: "8", label: "后端接口测试", desc: "鉴权、错误格式、安全响应头", color: tech-primary),
    stat-card(value: "2", label: "浏览器全流程", desc: "学生操作到运营员签到", color: tech-accent),
    stat-card(value: "6", label: "V2 链码测试", desc: "finance 4 组，activity 2 组", color: tech-purple),
    stat-card(value: "1", label: "生产构建", desc: "Vite build 通过", color: tech-success),
  )

  #v(13pt)

  #two-col-split(
    [
      #subhead([重点验证项])
      - *幂等性*：同一请求键重放，不重复扣款或发奖
      - *状态一致性*：截止时间与链上状态分开解释
      - *启动恢复*：`network.sh up` 可复用现有身份材料
      - *响应式*：桌面、700 px 与 390 px 页面完成复查
    ],
    [
      #subhead([证据边界], tag: badge-warning("说明"))
      - 接口与浏览器测试验证应用层状态衔接
      - Go 单元测试验证两个 V2 链码的业务规则
      - 真实演示核对交易回执、对象编号读回和幂等键重放
      - API 替身不能替代真实 Fabric 写入链路
    ]
  )
]

// ------------------------------------------------------------------------------
// 第 9 页，9:05 至 10:00
// 讲者备注：总结能保证与不能保证的边界。组织级私有数据不等于零知识匿名。
// 当多方确实需要共同复核状态时 Fabric 有价值；单一可信管理方应优先用数据库。
// ------------------------------------------------------------------------------
#slide(
  title: [能力边界与结论],
  subtitle: [课程项目的实现范围],
  section: [09 总结],
)[
  #two-col-split(
    [
      #subhead([系统能够验证], tag: badge-success("已实现"))
      - 组织身份与操作权限
      - 承诺、结果和状态变化
      - 私有数据只分发给授权组织
      - 幂等键阻止重复业务效果
    ],
    [
      #subhead([系统无法保证], tag: badge-danger("边界"))
      - 组织级隐私不等于零知识匿名
      - 承诺揭示仍依赖种子生成治理
      - 跨链码签到与发奖不是原子事务
      - 课程 Demo 不能直接作为生产系统
    ]
  )

  #v(14pt)

  #callout(type: "tech", title: [结论])[
    EventChain 把多方需要共同确认的校园参与状态交给 Fabric，并把个人仓位、申请和票据保存在组织级私有数据集合。若业务只有一个可信管理方，普通数据库更合适。
  ]
]
