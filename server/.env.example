PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JSON_LIMIT=256kb
JWT_SECRET=eventchain-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
DEMO_MODE=true
OPEN_STUDENT_REGISTRATION=false
# Leave these empty for a local Demo so deterministic development keys are
# derived from JWT_SECRET. Production must use independent 64-hex-character keys.
IDENTITY_LOOKUP_KEY=
IDENTITY_ENCRYPTION_KEY=
DEMO_BOOTSTRAP_KEY=eventchain-demo-bootstrap

# Fabric connection
FABRIC_CHANNEL=eventchain
FABRIC_PLATFORM_PEER_HOST=localhost
FABRIC_PLATFORM_PEER_PORT=7051
FABRIC_PLATFORM_CA_HOST=localhost
FABRIC_PLATFORM_CA_PORT=7054
FABRIC_ORGANIZER_PEER_HOST=localhost
FABRIC_ORGANIZER_PEER_PORT=9051
FABRIC_ORGANIZER_CA_HOST=localhost
FABRIC_ORGANIZER_CA_PORT=8054
FABRIC_STUDENT_PEER_HOST=localhost
FABRIC_STUDENT_PEER_PORT=11051
FABRIC_STUDENT_CA_HOST=localhost
FABRIC_STUDENT_CA_PORT=9054

# Chaincode names
CC_EVENT=event-cc
CC_PREDICTION=prediction-cc
CC_TICKET=ticket-cc
CC_TOKEN=token-cc
CC_FINANCE=finance
CC_ACTIVITY=activity
CLAIM_WORKER_ENABLED=true
CLAIM_WORKER_INTERVAL_MS=300000
CLAIM_WORKER_CONCURRENCY=5
CLAIM_WORKER_PAGE_SIZE=100
GATEWAY_CACHE_TTL_MS=600000

# Wallet path
WALLET_PATH=./wallet

# SQLite database path
DB_PATH=./data/users.db
