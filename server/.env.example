PORT=3000
JWT_SECRET=eventchain-dev-secret-change-in-production
JWT_EXPIRES_IN=24h
DEMO_MODE=true
OPEN_STUDENT_REGISTRATION=false
IDENTITY_LOOKUP_KEY=replace-with-64-hex-characters
IDENTITY_ENCRYPTION_KEY=replace-with-64-hex-characters
DEMO_BOOTSTRAP_KEY=replace-with-a-random-demo-bootstrap-key

# Fabric connection
FABRIC_CHANNEL=eventchain
FABRIC_GATEWAY_PEER=peer0.platform.eventchain.com:7051
FABRIC_CA_URL=https://ca.student.eventchain.com:7054

# Chaincode names
CC_EVENT=event-cc
CC_PREDICTION=prediction-cc
CC_TICKET=ticket-cc
CC_TOKEN=token-cc
CC_FINANCE=finance
CC_ACTIVITY=activity
CLAIM_WORKER_ENABLED=true
CLAIM_WORKER_INTERVAL_MS=300000
CLAIM_WORKER_CONCURRENCY=5
CLAIM_WORKER_PAGE_SIZE=100

# Wallet path
WALLET_PATH=./wallet

# SQLite database path
DB_PATH=./data/users.db
